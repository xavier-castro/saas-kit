{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-kit-user-application",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "vars": {
    "MY_VAR": "Hello from Cloudflare",
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "preview": {
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "preview"
      }
    }
  }
}
